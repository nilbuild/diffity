{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diffity",
  "version": "0.0.1",
  "identifier": "com.diffity.app",
  "build": {
    "beforeDevCommand": "node scripts/prepare-mcp.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare-mcp.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Diffity",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCQzQ2RjRENTlBNkUyQUQKUldTdDRxWlpUVy9FQ3krWmJ0WXlmSmNTZ1dGRUc2YWgydkpFaml1V2NXMlg3ckpuN0JIVmk5ZmQK",
      "endpoints": [
        "https://github.com/nilbuild/diffity/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/Assets.car",
      "icons/diffity-logo.icon",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/diffity-mcp"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3"
    }
  }
}
