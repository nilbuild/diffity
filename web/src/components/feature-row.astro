---
import Kbd from './ui/kbd.astro';
import RichText from './ui/rich-text.astro';
import type { FeatureRow } from '@/data/features';

interface Props {
  row: FeatureRow;
}

const props = Astro.props;
const { row } = props;
const linuxKbd = row.kbd?.replace('⌘', 'Ctrl+');
---

<div class="flex flex-wrap items-baseline gap-x-2 gap-y-1.5 py-1 text-sm leading-normal">
  {
    row.kbd && (
      <>
        <span class="os-mac">
          <Kbd>{row.kbd}</Kbd>
        </span>
        <span class="os-linux">
          <Kbd>{linuxKbd}</Kbd>
        </span>
      </>
    )
  }
  <b class="font-medium text-text">{row.term}</b>
  <span class="text-dot">·</span>
  <span class="text-[#616161]"><RichText text={row.text} /></span>
</div>
