---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Seo from '@/components/seo.astro';
import { SITE } from '@/lib/site';

interface Props {
  title?: string;
  description?: string;
}

const props = Astro.props;
const { title = SITE.title, description = SITE.description } = props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" preload />
    <Seo title={title} description={description} />
    <script is:inline>
      if (/Linux/.test(navigator.userAgent) && !/Android/.test(navigator.userAgent)) {
        document.documentElement.dataset.os = 'linux';
      }
    </script>
  </head>
  <body>
    <div class="mx-auto flex max-w-[1200px] items-stretch">
      <div class="hatch w-3.5 flex-none border-x border-frame max-[900px]:hidden"></div>
      <div class="flex min-w-0 flex-1 flex-wrap items-stretch">
        <slot />
      </div>
      <div class="hatch w-3.5 flex-none border-x border-frame max-[900px]:hidden"></div>
    </div>
  </body>
</html>
