---
import BaseLayout from '@/layouts/base.astro';
import ChapterHeader from '@/components/chapter-header.astro';
import ClosingCta from '@/components/closing-cta.astro';
import FeatureSection from '@/components/feature-section.astro';
import Hero from '@/components/hero.astro';
import Requirements from '@/components/requirements.astro';
import SiteFooter from '@/components/site-footer.astro';
import SiteSidebar from '@/components/site-sidebar.astro';
import TopBar from '@/components/top-bar.astro';
import { GROUPS, featuresIn } from '@/data/features';
---

<BaseLayout>
  <SiteSidebar />
  <main class="min-w-0 flex-[999_1_560px]">
    <TopBar />
    <Hero />
    <Requirements />
    {
      GROUPS.map((group) => (
        <>
          <ChapterHeader group={group} />
          {featuresIn(group).map((feature) => (
            <FeatureSection feature={feature} />
          ))}
        </>
      ))
    }
    <ClosingCta />
    <SiteFooter />
  </main>
</BaseLayout>
