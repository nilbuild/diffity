{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diffity Dev",
  "identifier": "com.diffity.app.dev",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Diffity Dev",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#ffffff",
        "visible": false
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["diffity-dev"]
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/dev/Assets.car",
      "icons/dev/diffity-dev.icon",
      "icons/dev/32x32.png",
      "icons/dev/128x128.png",
      "icons/dev/128x128@2x.png",
      "icons/dev/icon.icns",
      "icons/dev/icon.ico"
    ]
  }
}
