{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Diffity",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#ffffff",
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "rpm"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Review code changes, yours or your agent’s, GitHub-style",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "git"
        ],
        "desktopTemplate": "linux/diffity.desktop"
      },
      "rpm": {
        "depends": [
          "git"
        ],
        "desktopTemplate": "linux/diffity.desktop"
      }
    }
  }
}
